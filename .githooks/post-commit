#!/bin/sh
#
# Refreshes the VERSION file after every commit.
#
# The version number itself is derived from the history and needs nobody to
# raise it (see src/version.py), but the file that carries it to a copy without
# .git does need writing. Snappix also rewrites it the first time it starts
# after a commit; this closes the gap for anything that reads the file before
# that -- a package build or a copy to another machine, for instance.
#
# Activate once per checkout:  git config core.hooksPath .githooks
# The installer does that by itself for a checkout.
#
# Never fails a commit: everything here is best effort, and a missing Python
# simply leaves the file as it was.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if [ -x "$root/.venv/bin/python3" ]; then
    python="$root/.venv/bin/python3"
elif [ -x "$root/.venv/Scripts/python.exe" ]; then
    python="$root/.venv/Scripts/python.exe"
elif command -v python3 >/dev/null 2>&1; then
    python=python3
elif command -v python >/dev/null 2>&1; then
    python=python
else
    exit 0
fi

"$python" "$root/src/version.py" --write >/dev/null 2>&1 || exit 0

exit 0
